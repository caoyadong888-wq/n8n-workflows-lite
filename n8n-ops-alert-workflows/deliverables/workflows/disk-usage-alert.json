{
  "name": "Disk usage alert",
  "nodes": [
    {
      "id": "disk-note",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        -40
      ],
      "parameters": {
        "content": "## Disk usage alert\n\nRuns probe.py disk on / and /var. Warn at 80% used, critical at 90%. Telegram and email fire only when status is not ok.\n\nCredential ids are placeholders. In n8n, create a Telegram account credential and an SMTP account credential, then re-select them on Send Telegram and Send Email. Replace PLACEHOLDER_CHAT_ID. Mail uses alerts@example.com to ops@example.com. Install probe.py at /opt/ops-alerts/probe.py. No bot token or SMTP password is stored here.",
        "height": 420,
        "width": 420,
        "color": 4
      }
    },
    {
      "id": "disk-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        280
      ],
      "parameters": {}
    },
    {
      "id": "disk-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        80
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "disk-probe",
      "name": "Run Probe",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        280,
        180
      ],
      "parameters": {
        "command": "python3 /opt/ops-alerts/probe.py disk --path / --path /var --warn 80 --crit 90"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "disk-parse",
      "name": "Parse Probe JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst raw = item.stdout || item.output || \"\";\nlet report;\ntry {\n  report = JSON.parse(raw);\n} catch (error) {\n  report = {\n    check: \"probe\",\n    status: \"unknown\",\n    subject: \"Ops probe output was not JSON\",\n    message: String(error) + \"\\n\" + raw\n  };\n}\nif (!report.subject) {\n  report.subject = \"Ops alert \" + (report.check || \"probe\");\n}\nif (!report.message) {\n  report.message = JSON.stringify(report);\n}\nreturn [{ json: report }];\n"
      }
    },
    {
      "id": "disk-if",
      "name": "Needs Alert",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        840,
        180
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "disk-status",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "disk-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        40
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "PLACEHOLDER_CHAT_ID",
        "text": "={{ $json.subject }}\n\n{{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "PLACEHOLDER_TELEGRAM",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "disk-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1120,
        280
      ],
      "parameters": {
        "fromEmail": "alerts@example.com",
        "toEmail": "ops@example.com",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.message }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "PLACEHOLDER_SMTP",
          "name": "SMTP account"
        }
      }
    },
    {
      "id": "disk-ok",
      "name": "Within Threshold",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1120,
        500
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Run Probe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Run Probe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Probe": {
      "main": [
        [
          {
            "node": "Parse Probe JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Probe JSON": {
      "main": [
        [
          {
            "node": "Needs Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Alert": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Within Threshold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
